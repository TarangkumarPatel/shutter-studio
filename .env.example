# Local dev: "file:./dev.db" (SQLite). Production: your Neon Postgres
# connection strings (pooled + unpooled) — copy both from Vercel's Storage tab.
DATABASE_URL="file:./dev.db"
DATABASE_URL_UNPOOLED=""

# Admin panel password (never exposed client-side — checked server-side only)
ADMIN_PASSWORD="changeme"

# Secret used to sign the admin session cookie. Generate a strong random value
# for production, e.g.: openssl rand -hex 32
SESSION_SECRET="replace-with-a-long-random-string"

# Google Gemini API key for the AI photo face-off game (/game) — free tier,
# no billing/credit card required. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=""
